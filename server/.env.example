PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/nirali
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=https://your-public-domain.example
SHIPPING_FEE=100

# Optional comma-separated homepage ad image paths (up to 5). Put artwork under server/public/images/home/.
HOME_ADVERTISEMENT_IMAGES=

# Razorpay test-mode credentials only (never expose the secret to the browser).
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Nodemailer SMTP settings for email verification OTPs.
# Gmail example: smtp.gmail.com, port 587, EMAIL_SECURE=false.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Nirali Saree <your-email@gmail.com>"

# Recommended on free Render services, which block outbound SMTP ports.
BREVO_API_KEY=your-brevo-api-key

# Public site address, without a trailing slash.
PUBLIC_BASE_URL=https://your-public-domain.example

# Cloudinary is required for persistent admin product-image uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
