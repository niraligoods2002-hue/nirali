{
  "name": "abdul",
  "version": "1.0.0",
  "description": "Nirali Saree ecommerce storefront and admin dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:amplify": "node scripts/buildAmplifyBundle.js",
    "test": "node --test test/*.test.js",
    "build:widgets": "cd client-widgets && npm run build",
    "build:production": "npm --prefix client-widgets ci --include=dev && npm --prefix client-widgets run build",
    "seed": "node seed/seedProducts.js",
    "import:kalki": "node seed/importKalkiSarees.js",
    "import:category-catalog": "node seed/importCategoryCatalog.js",
    "migrate:product-images": "node seed/migrateImportedProductImages.js",
    "migrate:product-gallery": "node seed/addProductGalleryImages.js",
    "seed:admin": "node seed/seedAdmin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
