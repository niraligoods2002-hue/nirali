<div class="auth-page">
  <div class="auth-card">
    <div class="auth-brand">
      <img src="/images/branding/nirali-woman-mark.png" alt="Nirali logo" class="auth-logo" />
      <span class="brand-text">NIRALI</span>
    </div>
    <span class="section-tag">ACCOUNT RECOVERY</span>
    <h1>Choose New Password</h1>
    <p class="auth-note">Use at least 8 characters with a letter and a number.</p>

    <form class="auth-form" id="reset-password-form">
      <div class="form-row password-row">
        <label>
          New Password
          <input type="password" name="password" id="reset-password" required minlength="8" autocomplete="new-password" />
        </label>
        <button type="button" class="toggle-password">Show</button>
      </div>
      <div class="form-row">
        <label>
          Confirm New Password
          <input type="password" name="confirmPassword" id="reset-confirm-password" required minlength="8" autocomplete="new-password" />
        </label>
      </div>
      <button type="submit" class="btn-primary btn-block">Reset Password</button>
      <p class="auth-status" id="reset-password-status" role="status"></p>
      <p class="auth-link"><a href="/login">Back to sign in</a></p>
    </form>
  </div>
</div>
