<div class="auth-page">
  <div class="auth-card">
    <div class="auth-brand">
      <a href="/" class="auth-brand-link" aria-label="NIRALI Home">
        <img src="/images/nirali-logo.png" alt="NIRALI" class="auth-logo-img logo-light" />
        <img src="/images/nirali-logo-dark.png" alt="NIRALI" class="auth-logo-img logo-dark" />
      </a>
    </div>

    <div class="auth-card-header text-center">
      <span class="section-eyebrow">ACCOUNT RECOVERY</span>
      <h1 class="auth-title">Forgot Password</h1>
      <p class="auth-subtitle">Enter your registered email address and we will dispatch a secure reset link.</p>
    </div>

    <form class="auth-form" id="forgot-password-form">
      <div class="form-group">
        <label for="forgot-email" class="form-label">Email Address</label>
        <input type="email" name="email" id="forgot-email" class="form-input" required autocomplete="email" placeholder="name@domain.com" />
      </div>

      <button type="submit" class="btn-primary btn-block auth-submit-btn">Send Recovery Link</button>
      <p class="auth-status" id="forgot-password-status" role="status"></p>

      <div class="auth-footer-nav text-center">
        <a href="/login" class="btn-text-link">&larr; Return to Sign In</a>
      </div>
    </form>
  </div>
</div>
