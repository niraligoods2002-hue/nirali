<div class="auth-page">
  <div class="auth-card">
    <div class="auth-brand">
      <img src="/images/branding/nirali-woman-mark.png" alt="Nirali logo" class="auth-logo" />
      <span class="brand-text">NIRALI</span>
    </div>
    <span class="section-tag">ACCOUNT RECOVERY</span>
    <h1>Forgot Password</h1>
    <p class="auth-note">Enter your email and we will send you a secure reset link.</p>

    <form class="auth-form" id="forgot-password-form">
      <div class="form-row">
        <label>
          Email
          <input type="email" name="email" id="forgot-email" required autocomplete="email" />
        </label>
      </div>
      <button type="submit" class="btn-primary btn-block">Send Reset Link</button>
      <p class="auth-status" id="forgot-password-status" role="status"></p>
      <p class="auth-link"><a href="/login">Back to sign in</a></p>
    </form>
  </div>
</div>
