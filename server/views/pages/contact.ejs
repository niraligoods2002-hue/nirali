    <div class="contact-editorial-header text-center">
      <span class="section-eyebrow">CLIENT SERVICES</span>
      <h1 class="contact-hero-title">Atelier Concierge</h1>
      <p class="contact-hero-sub">
        Whether you desire styling advice for an upcoming wedding or assistance with an order, our concierges are pleased to assist you.
      </p>
      <div class="story-divider" style="margin: 1.5rem auto;"></div>
    </div>

    <div class="contact-editorial-layout">
      <!-- Contact Form -->
      <div class="contact-form-card">
        <h3 class="card-title">Send a Message</h3>
        <p class="card-sub">We reply to every patron inquiry within 24 business hours.</p>

        <form class="contact-form" id="contact-form">
          <div class="form-group">
            <label for="contact-name" class="form-label">Full Name</label>
            <input type="text" name="name" id="contact-name" class="form-input" required placeholder="Your full name" />
          </div>

          <div class="form-group">
            <label for="contact-email" class="form-label">Email Address</label>
            <input type="email" name="email" id="contact-email" class="form-input" required placeholder="name@domain.com" />
          </div>

          <div class="form-group">
            <label for="contact-phone" class="form-label">Mobile Number (Optional)</label>
            <input type="tel" name="phone" id="contact-phone" class="form-input" placeholder="+91 00000 00000" />
          </div>

          <div class="form-group">
            <label for="contact-message" class="form-label">Inquiry or Request</label>
            <textarea name="message" id="contact-message" rows="5" class="form-textarea" required placeholder="Tell us about the saree, occasion, or assistance you require..."></textarea>
          </div>

          <button type="submit" class="btn-primary btn-block">Submit Inquiry</button>
          <div class="contact-status" id="contact-status"></div>
        </form>
      </div>

