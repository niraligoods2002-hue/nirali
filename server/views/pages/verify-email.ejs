<div class="auth-page">
  <div class="auth-card">
    <div class="auth-brand">
      <a href="/" class="auth-brand-link" aria-label="NIRALI Home">
        <img src="/images/nirali-logo.png" alt="NIRALI" class="auth-logo-img logo-light" />
        <img src="/images/nirali-logo-dark.png" alt="NIRALI" class="auth-logo-img logo-dark" />
      </a>
    </div>

    <div class="auth-card-header text-center">
      <span class="section-eyebrow">VERIFICATION</span>
      <h1 class="auth-title">Verify Account</h1>
      <p class="auth-subtitle">A verification code has been dispatched to your email address.</p>
    </div>

    <form class="auth-form" id="verify-form">
      <div class="form-group">
        <label for="otp" class="form-label">Verification OTP</label>
        <input type="text" name="otp" id="otp" class="form-input" required maxlength="6" placeholder="6-digit code" />
      </div>

      <button type="submit" class="btn-primary btn-block auth-submit-btn">Verify & Continue</button>
      <p class="auth-status" id="verify-status" role="status"></p>

      <div class="auth-footer-nav text-center">
        <a href="/login" class="btn-text-link">&larr; Return to Sign In</a>
      </div>
    </form>
  </div>
</div>
