<div class="reviews-editorial-page section-padding">
  <div class="container">
    
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <span class="current">Patron Diaries</span>
    </nav>

    <div class="reviews-editorial-header text-center">
      <span class="section-eyebrow">CLIENT REFLECTIONS</span>
      <h1 class="reviews-hero-title">Patron Diaries</h1>
      <p class="reviews-hero-sub">
        Honest words and experiences shared by women who have draped NIRALI handlooms for life’s most cherished celebrations.
      </p>
      <div class="story-divider" style="margin: 1.5rem auto;"></div>
    </div>

    <!-- Review Submission Panel -->
    <section class="review-submit-panel">
      <% if (user) { %>
        <div class="submit-panel-header">
          <span class="section-eyebrow">SHARE YOUR EXPERIENCE</span>
          <h2 class="submit-title">Write a Review</h2>
          <p class="submit-sub">Share your thoughts on the weave, drape, packaging, and service.</p>
        </div>

        <form class="review-form" id="review-form">
          <div class="form-group">
            <label class="form-label">Your Rating</label>
            <input type="hidden" name="rating" id="review-rating" value="5" />
            <div class="review-rating-buttons" role="radiogroup" aria-label="Choose rating">
              <% for (let i = 1; i <= 5; i++) { %>
                <button
                  type="button"
                  class="review-star-btn active"
                  data-rating="<%= i %>"
                  aria-label="<%= i %> star<%= i > 1 ? 's' : '' %>"
                  aria-checked="<%= i === 5 ? 'true' : 'false' %>"
                  role="radio"
                >
                  ★
                </button>
              <% } %>
            </div>
          </div>

          <div class="form-group">
            <label for="review-text" class="form-label">Your Review & Thoughts</label>
            <textarea
              name="text"
              id="review-text"
              rows="4"
              minlength="10"
              maxlength="600"
              class="form-textarea"
              required
              placeholder="Tell other patrons about the fabric texture, zari luster, and how it draped on your occasion..."
            ></textarea>
          </div>

          <button type="submit" class="btn-primary">Submit for Approval</button>
          <p class="review-status" id="review-status" role="status"></p>
        </form>
      <% } else { %>
        <div class="review-signin-prompt text-center">
          <span class="section-eyebrow">SHARE YOUR EXPERIENCE</span>
          <h2 class="submit-title">Cherish a NIRALI Saree?</h2>
          <p class="submit-sub">Sign in to your patron account to submit a review and rating.</p>
          <a href="/login?redirect=/reviews" class="btn-primary" style="margin-top: 1rem;">Sign In to Review</a>
        </div>
      <% } %>
    </section>

    <!-- Reviews Grid -->
    <div class="reviews-editorial-grid">
      <% reviews.forEach(review => { %>
        <article class="review-editorial-card">
          <div class="review-stars-gold">
            <% for (let i = 0; i < 5; i++) { %>
              <span class="star <%= i < review.rating ? 'filled' : 'empty' %>">★</span>
            <% } %>
          </div>
          <blockquote class="review-editorial-quote">
            “<%= review.text %>”
          </blockquote>
          <div class="review-editorial-author">
            <strong class="author-name"><%= review.name %></strong>
            <span class="review-meta-date">Verified Patron &bull; <%= review.date %></span>
          </div>
        </article>
      <% }) %>
    </div>

  </div>
</div>
