<div class="auth-page">
  <div class="auth-card">
    <div class="auth-brand">
      <a href="/" class="auth-brand-link" aria-label="NIRALI Home">
        <img src="/images/nirali-logo.png" alt="NIRALI" class="auth-logo-img logo-light" />
        <img src="/images/nirali-logo-dark.png" alt="NIRALI" class="auth-logo-img logo-dark" />
      </a>
    </div>

    <div class="auth-card-header text-center">
      <span class="section-eyebrow">MEMBERSHIP</span>
      <h1 class="auth-title">Create Account</h1>
      <p class="auth-subtitle">Join the NIRALI circle for bespoke curation releases and priority ordering.</p>
    </div>

    <form class="auth-form" id="signup-form">
      <div class="form-group">
        <label for="name" class="form-label">Full Name</label>
        <input type="text" name="name" id="name" class="form-input" required minlength="2" autocomplete="name" placeholder="Your full name" />
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" name="email" id="email" class="form-input" required autocomplete="email" placeholder="name@domain.com" />
      </div>

      <div class="form-group password-group">
        <div class="password-label-row">
          <label for="password" class="form-label">Create Password</label>
        </div>
        <div class="password-input-wrap">
          <input type="password" name="password" id="password" class="form-input" required minlength="8" autocomplete="new-password" placeholder="8+ characters, including a letter and a number" />
          <button type="button" class="toggle-password" id="toggle-password" aria-label="Toggle password visibility">Show</button>
        </div>
      </div>

      <button type="submit" class="btn-primary btn-block auth-submit-btn">Create Account</button>
      <div class="auth-status" id="auth-status" role="status" aria-live="polite"></div>

      <div class="auth-footer-nav text-center">
        <p class="auth-switch-text">
          Already have an account? <a href="/login" class="btn-text-link">Sign In &rarr;</a>
        </p>
      </div>
    </form>
  </div>
</div>
