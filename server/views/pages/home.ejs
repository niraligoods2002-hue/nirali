</section>

<!-- Newsletter Subscription -->
<section class="section-newsletter section-padding">
  <div class="container text-center">
    <span class="section-eyebrow">THE NIRALI CIRCLE</span>
    <h2 class="section-title">Receive Private Previews</h2>
    <p class="section-desc" style="max-width: 580px; margin: 0 auto 2rem;">Subscribe to enjoy bespoke curation announcements, styling notes, and invitations to upcoming heritage collections.</p>
    <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for joining the NIRALI Circle. Welcome to our private client registry.');">
      <input type="email" placeholder="Enter your email address" class="newsletter-input" required />
      <button type="submit" class="btn-primary">Join Concierge</button>
    </form>
  </div>
</section>
