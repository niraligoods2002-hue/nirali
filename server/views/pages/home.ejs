<!-- Shop By Category (Editorial Grid) -->
<section class="section-categories section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-eyebrow">CURATED DRAPES</span>
      <h2 class="section-title">Shop by Category</h2>
      <p class="section-desc">Explore our signature fabric collections curated for weddings, festivals, and evening soirees.</p>
    </div>

    <div class="categories-editorial-grid">
      <% featuredCategories.forEach((cat, index) => { 
        const catImg = categoryImages[cat.name] || `/images/products/saree${(index % 3) + 1}.jpg`;
      %>
        <a href="/shop?filter=<%= encodeURIComponent(cat.filter) %>" class="category-editorial-card <%= index === 0 ? 'category-card-large' : '' %>">
          <div class="category-card-bg">
            <img src="<%= catImg %>" alt="<%= cat.label %>" loading="lazy" />
          </div>
          <div class="category-card-overlay"></div>
          <div class="category-card-text">
            <span class="category-card-eyebrow">COLLECTION</span>
            <h3 class="category-card-name"><%= cat.label %></h3>
            <p class="category-card-desc"><%= cat.desc %></p>
            <span class="category-explore-link">Explore Edit &rarr;</span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured Products Stream (Mounted via React Widget) -->
<section class="section-featured-products section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-eyebrow">THE NIRALI ATELIER</span>
      <h2 class="section-title">Curated Masterpieces</h2>
      <p class="section-desc">Every piece is thoughtfully woven with intricate zari and pure fabrics.</p>
    </div>

    <!-- React mount container -->
    <div id="featured-products-root" data-products="<%= JSON.stringify(homeProducts) %>"></div>

    <div class="section-footer-action text-center">
      <a href="/shop" class="btn-primary">View Entire Collection</a>
    </div>
  </div>
</section>

<!-- Brand Story Editorial Section -->
<section class="section-brand-story">
  <div class="container brand-story-container">
    <div class="brand-story-image-col">
      <div class="story-image-frame">
        <img src="/images/about/about.jpg" alt="Artisans at NIRALI Atelier" loading="lazy" />
        <div class="story-image-badge">
          <span>HERITAGE WEAVES &bull; ESTD. INDIA</span>
        </div>
      </div>
    </div>
    
    <div class="brand-story-text-col">
      <span class="section-eyebrow">OUR PHILOSOPHY</span>
      <h2 class="story-title">Crafted with Passion</h2>
      <div class="story-divider"></div>
      <p class="story-lead">
        At NIRALI, we believe every saree is an enduring canvas of poetry, culture, and feminine grace.
      </p>
      <p class="story-body">
        Our journey began with a singular devotion: to preserve and elevate the sacred traditions of Indian handloom weaving for the modern connoisseur. From the delicate drape of whisper-soft chiffons to the timeless grandeur of pure Banarasi silks, our curations honor the generational master weavers whose hands breathe life into each thread.
      </p>
      <p class="story-body">
        We marry historic motifs with contemporary color harmonies, creating timeless heirlooms designed to be cherished across generations.
      </p>
      <div class="story-actions">
        <a href="/about" class="btn-secondary">Discover Our Heritage</a>
      </div>
    </div>
  </div>
</section>

