<%
  const heroProducts = ((homeProducts || []).filter(product => product.bestseller || product.featured || product.newArrival).length
    ? (homeProducts || []).filter(product => product.bestseller || product.featured || product.newArrival)
    : (homeProducts || [])
  ).slice(0, 3);

  const advertisementSlides = (homeAdvertisementSlides || []).length ? homeAdvertisementSlides : heroProducts.length ? heroProducts : [
    { name: "NIRALI Heritage Sarees", image: "/images/products/saree1.jpg", slug: "" },
  ];

  const featuredCategories = [
    { name: "Chiffon Saree", label: "Chiffon Sarees", desc: "Featherlight elegance with delicate zari borders", filter: "category:Chiffon Saree" },
    { name: "Georgette Saree", label: "Georgette Sarees", desc: "Flowing silhouettes crafted for royal celebrations", filter: "category:Georgette Saree" },
    { name: "Cotton Saree", label: "Cotton Sarees", desc: "Breathable handloom weaves for daytime sophistication", filter: "category:Cotton Saree" },
    { name: "Designer Saree", label: "Designer Sarees", desc: "Statement couture pieces tailored for weddings", filter: "category:Designer Saree" },
    { name: "Printed Saree", label: "Printed Sarees", desc: "Artisanal floral and geometric handprints", filter: "category:Printed Saree" },
  ];

  // Map each category to a representative product image
  const categoryImages = {};
  (homeProducts || []).forEach(p => {
    if (p.category && !categoryImages[p.category] && p.image) {
      categoryImages[p.category] = p.image;
    }
  });
%>

<!-- Promotional hero: replace a slide image with campaign artwork when ready. -->
<section class="advert-hero" data-masterpiece-slider aria-label="NIRALI seasonal advertisements">
  <div class="advert-slides">
    <% advertisementSlides.forEach((slide, index) => { %>
      <article class="advert-slide advert-poster advert-poster-<%= index % 5 %> <%= index === 0 ? 'active' : '' %>" data-slide aria-hidden="<%= index !== 0 %>">
        <div class="advert-poster-ornament" aria-hidden="true"></div>
        <div class="advert-copy">
          <span class="advert-eyebrow"><%= slide.eyebrow || slide.category || 'THE NIRALI FESTIVE EDIT' %></span>
          <h1 class="advert-title"><%= slide.title || slide.name || 'Celebrate in Heirloom Style' %></h1>
          <p class="advert-description"><%= slide.description || 'Discover handcrafted sarees made for the moments you will remember.' %></p>
          <a class="advert-cta" href="<%= slide.linkUrl || (slide.slug ? '/products/' + encodeURIComponent(slide.slug) : '/shop') %>"><%= slide.linkLabel || 'Explore the Collection' %> <span aria-hidden="true">→</span></a>
          <span class="advert-note"><%= slide.note || 'Handpicked styles · Pan-India delivery' %></span>
        </div>
        <figure class="advert-artwork">
          <span class="advert-artwork-frame" aria-hidden="true"></span>
          <img class="advert-slide-image" src="<%= slide.image || '/images/products/saree1.jpg' %>" alt="<%= slide.name || slide.title || 'NIRALI campaign' %>" <%= index === 0 ? '' : 'loading="lazy"' %> />
        </figure>
        <span class="advert-slide-index"><%= String(index + 1).padStart(2, '0') %> / <%= String(advertisementSlides.length).padStart(2, '0') %></span>
      </article>
    <% }); %>
  </div>

  <% if (advertisementSlides.length > 1) { %>
    <button type="button" class="advert-arrow advert-arrow-prev" data-slide-prev aria-label="Previous advertisement">‹</button>
    <button type="button" class="advert-arrow advert-arrow-next" data-slide-next aria-label="Next advertisement">›</button>
    <div class="advert-dots" role="group" aria-label="Choose advertisement">
      <% advertisementSlides.forEach((slide, index) => { %>
        <button type="button" class="advert-dot <%= index === 0 ? 'active' : '' %>" data-slide-dot="<%= index %>" aria-label="Show advertisement <%= index + 1 %>" aria-current="<%= index === 0 ? 'true' : 'false' %>"></button>
      <% }); %>
    </div>
  <% } %>
</section>

<!-- Continuously scrolling store offers -->
<section class="offers-ticker" aria-label="Current store offers">
  <span class="offers-ticker-label">NIRALI OFFERS</span>
  <div class="offers-ticker-window">
    <div class="offers-ticker-track">
      <% [0, 1].forEach((copyIndex) => { %>
        <div class="offers-ticker-group" aria-hidden="<%= copyIndex === 1 ? 'true' : 'false' %>">
          <% (homeOffers || ['Complimentary shipping on orders above ₹2,999']).forEach((offer) => { %>
            <span><%= offer %></span><i>✦</i>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </div>
</section>

