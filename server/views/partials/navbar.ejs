          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- Mobile Menu Hamburger -->
      <button class="menu-btn" id="menu-btn" type="button" aria-label="Open mobile navigation" aria-expanded="false" aria-controls="mobile-drawer">
